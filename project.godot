; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Junior Astronaut Mission Trainer — Beta 0.2"
run/main_scene="uid://gpl4sppkwcr6"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
# `viewport` scales both the rendered HUD and pointer coordinates together.
# This is important for the web export: with canvas_items a browser resize can
# leave button input rectangles offset from their visible positions.
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Junior Astronaut Mission Trainer — Beta 0.2"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
