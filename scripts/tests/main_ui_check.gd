extends SceneTree

func _initialize() -> void:
	call_deferred("_check")

func _check() -> void:
	var scene: Node = load("res://scenes/main/main.tscn").instantiate()
	root.add_child(scene)
	var clock: Node = scene.get_node("GameManager")
	var sim: Node = scene.get_node("BaseSimulation")
	var base: Node = scene.get_node("LunarBase")
	var hud: Control = scene.get_node("UI/UIStub")
	var resources: Node = scene.get_node("ResourceManager")
	var crew: Node = base.get_node("Astronaut/CrewTaskController")
	clock.start_mission()
	assert(sim.crew.size() == 4)
	for member: Node in sim.crew:
		member._process(20.0)
	var animation: AnimationPlayer = base.get_node("Astronaut/Model/AnimationPlayer")
	assert(animation.has_animation("Idle_A") and animation.has_animation("Walking_A"))
	assert(is_equal_approx(resources.solar_generation_kw, 0.6))
	assert(sim._solar_overlays.size() > 0 and hud.get_node("ResourcesPanel/Readout").text.contains("SUN 60%"))
	assert(crew.start_task("clean_solar") and crew.state == "working")
	assert(animation.current_animation == "Idle_A")
	var initial_position: Vector3 = base.get_node("Astronaut").global_position
	clock.set_paused(true)
	crew._process(5.0)
	assert(base.get_node("Astronaut").global_position == initial_position)
	clock.set_paused(false)
	crew._process(5.0)
	assert(crew.state == "idle" and is_equal_approx(resources.solar_generation_kw, 1.0))
	assert(sim._solar_overlays.is_empty() and hud.get_node("ResourcesPanel/Readout").text.contains("SUN 100%"))
	crew._process(30.0)
	assert(crew.state == "idle")
	assert(crew.start_task("clean_solar"))
	assert(sim.start_scenario("solar_flare"))
	assert(crew.current_task == "" and not sim.protected_mode)
	crew._process(30.0)
	assert(crew.state == "sheltering")
	sim.advance_minutes(60.0)
	assert(crew.state == "idle" and not crew.get_parent().visible)
	crew._process(20.0)
	assert(crew.state == "idle")
	assert(not hud.get_node("DangerBanner").visible)
	resources.water_kg = 100.0
	resources.food_kg = 100.0
	assert(clock.mis_day == 1)
	clock._process(300.0)
	assert(clock.mis_day == 2 and clock.elapsed_minutes == 1440)
	assert(sim.research > 0.0)
	var dome: Node = base.get_node("ScienceDome")
	base.remove_child(dome)
	var previous_research: float = sim.research
	sim.advance_minutes(60.0)
	assert(is_equal_approx(sim.research, previous_research))
	base.add_child(dome)
	var array: Node = base.get_node("SolarArrayWest")
	base.remove_child(array)
	sim.advance_minutes(1.0)
	assert(is_equal_approx(resources.solar_generation_kw, 2.0 / 3.0))
	base.add_child(array)
	clock.set_speed(2)
	clock._process(150.0)
	assert(clock.mis_day == 3)
	clock.set_speed(5)
	clock._process(60.0)
	assert(clock.mis_day == 4)
	clock.set_paused(true)
	clock._process(300.0)
	assert(clock.mis_day == 4)
	assert(hud.get_node("TimeReadout").text.contains("MISSION DAY 04 / 30"))
	assert(sim.start_scenario("solar_flare"))
	assert(sim.radiation_level > 50.0 and hud.get_node("DangerBanner").visible)
	var before: float = sim.crew_dose
	sim.advance_minutes(60.0)
	assert(sim.crew_dose > before and sim.active_scenario == "")
	assert(sim.start_scenario("cme_warning"))
	assert(sim.radiation_level < 50.0 and hud.get_node("NotificationBanner").visible)
	sim.advance_minutes(30.0)
	assert(sim.radiation_level >= 50.0 and hud.get_node("DangerBanner").visible)
	sim.advance_minutes(60.0)
	assert(sim.start_scenario("sep_event") and sim.radiation_level > 90.0)
	clock.set_paused(false)
	crew._process(20.0)
	assert(crew.state == "sheltering")
	for member: Node in sim.crew:
		member._process(20.0)
	clock.set_paused(true)
	sim.advance_minutes(60.0)
	var habitat: Node = base.get_node("CrewHabitat")
	for member: Node in sim.crew:
		member._set_state("sheltering")
	before = sim.crew_dose
	sim.advance_minutes(60.0)
	var protected: float = sim.crew_dose - before
	base.remove_child(habitat)
	before = sim.crew_dose
	sim.advance_minutes(60.0)
	assert(sim.crew_dose - before > protected)
	base.add_child(habitat)
	var adapter: Node = load("res://scripts/simulation/donki_adapter.gd").new()
	root.add_child(adapter)
	assert(adapter.events.has("FLR") and adapter.events.has("CME") and adapter.events.has("SEP"))
	assert(adapter.source in ["cache", "stub"])
	clock.set_paused(false)
	clock._process(300.0 * 30.0)
	assert(clock.campaign_complete and clock.mis_day == 30 and clock.elapsed_minutes == 43200)
	var stopped: int = clock.elapsed_minutes
	clock._process(100.0)
	assert(clock.elapsed_minutes == stopped)
	print("MAIN_UI_CHECK_PASSED")
	quit()
